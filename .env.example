# Copy to .env for local development and fill in real values.
# Never commit .env — on Render, set these in the service's Environment settings.

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=*

# Supabase PostgreSQL (leave blank locally to use SQLite; required in production)
DB_NAME=
DB_USER=
DB_HOST=
DB_PORT=6543
DB_PASSWORD=

# Supabase Storage (Supabase Dashboard → Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=ecommerce-media

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Outgoing email (Gmail app password)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
